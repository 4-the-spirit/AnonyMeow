{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "AzureAdB2C": {
    "Instance": "",
    "ClientId": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:5173"
  },
  "Reactions": {
    "AllowedEmojis": ["👍", "👎", "❤️", "😂", "😮", "😢", "🔥"]
  },
  "PostImages": {
    "MaxImageCount": 6,
    "MaxImageSizeBytes": 8388608
  },
  "PiiDetection": {
    "DetectorModes": {
      "EmailPattern": "Block",
      "PhoneNumber": "Block",
      "AddressHeuristic": "LogOnly"
    },
    "AppliesTo": ["Post", "Comment", "DirectMessage"]
  },
  "ActionRateLimits": {
    "CreatePost": { "PermitLimit": 5, "WindowSeconds": 300 },
    "CreateComment": { "PermitLimit": 15, "WindowSeconds": 300 },
    "SendMessage": { "PermitLimit": 30, "WindowSeconds": 300 },
    "Vote": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Report": { "PermitLimit": 10, "WindowSeconds": 300 },
    "ImageUpload": { "PermitLimit": 30, "WindowSeconds": 86400 },
    "SignUpStart": { "PermitLimit": 5, "WindowSeconds": 600 },
    "SignUpVerify": { "PermitLimit": 5, "WindowSeconds": 600 },
    "SignInStart": { "PermitLimit": 5, "WindowSeconds": 600 },
    "PasswordReset": { "PermitLimit": 5, "WindowSeconds": 600 },
    "RefreshToken": { "PermitLimit": 20, "WindowSeconds": 300 }
  },
  "SpamDetection": {
    "NewAccountWindowMinutes": 60,
    "MaxSubmissionsForNewAccounts": 5,
    "PostingFrequencyWindowMinutes": 10,
    "DuplicateContentLookbackHours": 24,
    "BlockedLinkDomains": []
  }
}
