flowchart TB
    subgraph L1["Endpoints layer — thin handlers"]
        E1["*Endpoints.cs<br/>route mapping, model binding,<br/>RequireAuthorization / RequireRateLimiting"]
    end

    subgraph L2["Service layer — business logic (DI-injected interfaces)"]
        S1["Domain services<br/>Post / Comment / Voting / Reaction /<br/>Feed / Community / Friendship / ..."]
        S2["Cross-cutting services<br/>ContentSubmissionPipeline, PII/Spam Detection,<br/>Ranking (Strategy), NotificationDispatcher"]
        S3["Native-auth flow services<br/>SignUp / SignIn / PasswordReset"]
    end

    subgraph L3["Data layer"]
        D1["AppDbContext (EF Core)"]
        D2["Entity Configurations<br/>Data/Configurations/*"]
    end

    subgraph Cross["Cross-cutting (registered once, used pipeline-wide)"]
        X1["Authorization Handlers<br/>ProfileCompletion / CommunityModerator / PlatformAdmin"]
        X2["CurrentUserAccessor<br/>JIT AppUser provisioning from JWT 'oid'"]
        X3["Options (IOptions / IOptionsMonitor)<br/>RateLimiting, PII, Spam, BlobStorage, NativeAuth, ..."]
    end

    E1 --> S1
    E1 --> S3
    S1 --> S2
    S1 --> D1
    S2 --> D1
    S3 -->|HttpClient| CIAM(["Entra External ID (CIAM)"])
    D1 --> D2
    D1 --> PG[("PostgreSQL")]
    E1 -.uses.-> X1
    E1 -.uses.-> X2
    S1 -.reads.-> X3
    S2 -.reads.-> X3
