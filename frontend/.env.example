# Base URL of the AnonyMeow backend API. Copy to .env.local to override locally
# (.env.local is gitignored; .env.development is the committed default for dev).
VITE_API_BASE_URL=https://localhost:7225

# Set to "true" to use the real email/password sign-up-and-sign-in UI (backed by the backend's
# native-auth proxy to Microsoft Entra External ID). Leave unset to keep using the dev-only
# /api/dev/token bypass — see docs/azure-ciam-setup.md for how to provision a tenant.
VITE_REAL_AUTH_ENABLED=
